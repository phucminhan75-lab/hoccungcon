{
  "trailingSlash": true,
  "rewrites": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "hoc.huongnghiepalpha.vn" }], "destination": "/hoc/$1" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "ta1.huongnghiepalpha.vn" }], "destination": "/ta1/$1" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "to1.huongnghiepalpha.vn" }], "destination": "/to1/$1" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "ta2.huongnghiepalpha.vn" }], "destination": "/ta2/$1" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "to2.huongnghiepalpha.vn" }], "destination": "/to2/$1" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "ta10.huongnghiepalpha.vn" }], "destination": "/ta10/$1" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "khtn2.huongnghiepalpha.vn" }], "destination": "/khtn2/$1" },
    { "source": "/", "destination": "/hoc/index.html" }
  ]
}

